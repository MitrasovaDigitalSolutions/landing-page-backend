{
  "openapi": "3.0.3",
  "info": {
    "title": "Mitrasova Headless Multi-Tenant CMS API",
    "version": "1.0.0",
    "description": "Headless Multi-Tenant CMS backend API powering business unit landing pages (KSP, Konveksi, Teknologi, Percetakan, Transportasi, Bengkel Las)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment"
    }
  ],
  "security": [
    {
      "SiteKey": []
    }
  ],
  "paths": {
    "/api/v1/settings": {
      "get": {
        "summary": "Get site settings",
        "description": "Returns grouped key-value settings for the resolved tenant site.",
        "tags": ["Settings"],
        "responses": {
          "200": {
            "description": "Settings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/pages/{slug}": {
      "get": {
        "summary": "Get page detail by slug",
        "description": "Returns page data including all sections ordered by order asc.",
        "tags": ["Pages"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Slug of the page (e.g. home, about)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/ResourceNotFound" }
        }
      }
    },
    "/api/v1/service-types": {
      "get": {
        "summary": "List service types",
        "description": "Returns service types with count of active services.",
        "tags": ["Services"],
        "responses": {
          "200": {
            "description": "List of service types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceTypesResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "summary": "List services",
        "description": "Returns paginated services with filtering.",
        "tags": ["Services"],
        "parameters": [
          {
            "name": "service_type",
            "in": "query",
            "required": false,
            "description": "Filter by service type slug or ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "description": "Filter by featured flag (true/false)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Number of items per page (default: 15, max: 100)",
            "schema": {
              "type": "integer",
              "default": 15
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated services list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicesListResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/services/{slug}": {
      "get": {
        "summary": "Get service detail",
        "description": "Returns single service detail with its service type.",
        "tags": ["Services"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Service slug",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDetailResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/ResourceNotFound" }
        }
      }
    },
    "/api/v1/portfolios": {
      "get": {
        "summary": "List portfolios",
        "description": "Returns paginated portfolios with filtering by service type.",
        "tags": ["Portfolios"],
        "parameters": [
          {
            "name": "service_type",
            "in": "query",
            "required": false,
            "description": "Filter by service type slug or ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "description": "Filter by featured flag",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page",
            "schema": {
              "type": "integer",
              "default": 15
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated portfolios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfoliosListResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/portfolios/{slug}": {
      "get": {
        "summary": "Get portfolio detail",
        "description": "Returns single portfolio item.",
        "tags": ["Portfolios"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Portfolio slug",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Portfolio detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioDetailResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/ResourceNotFound" }
        }
      }
    },
    "/api/v1/article-categories": {
      "get": {
        "summary": "List article categories",
        "description": "Returns article categories with published articles count.",
        "tags": ["Articles"],
        "responses": {
          "200": {
            "description": "List of categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleCategoriesResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/articles": {
      "get": {
        "summary": "List articles",
        "description": "Returns paginated list of published articles.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug or ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated published articles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlesListResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/articles/{slug}": {
      "get": {
        "summary": "Get article detail",
        "description": "Returns published article detail.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Article slug",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Article detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetailResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/ResourceNotFound" }
        }
      }
    },
    "/api/v1/faqs": {
      "get": {
        "summary": "List FAQs",
        "description": "Returns active FAQs, optionally grouped by category when grouped=true.",
        "tags": ["FAQs"],
        "parameters": [
          {
            "name": "grouped",
            "in": "query",
            "required": false,
            "description": "Whether to return FAQs grouped by categories",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List or grouped list of FAQs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqsResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/testimonials": {
      "get": {
        "summary": "List testimonials",
        "description": "Returns active testimonials ordered by order asc.",
        "tags": ["Testimonials"],
        "responses": {
          "200": {
            "description": "List of testimonials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestimonialsResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/partners": {
      "get": {
        "summary": "List partners",
        "description": "Returns partner logos and links.",
        "tags": ["Partners"],
        "responses": {
          "200": {
            "description": "List of partners",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnersResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" }
        }
      }
    },
    "/api/v1/inquiries": {
      "post": {
        "summary": "Submit customer inquiry",
        "description": "Submits a contact form or service inquiry for the resolved tenant site.",
        "tags": ["Inquiries"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InquiryRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/InquiryMultipartRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inquiry submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InquiryResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingSiteKey" },
          "404": { "$ref": "#/components/responses/SiteNotFound" },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SiteKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Site-Key",
        "description": "Tenant API Key (e.g. key-ksp-12345) or Site Slug (e.g. ksp)"
      }
    },
    "responses": {
      "MissingSiteKey": {
        "description": "Header X-Site-Key is required",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Header X-Site-Key is required" }
              }
            }
          }
        }
      },
      "SiteNotFound": {
        "description": "Site not found or inactive",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Site not found or inactive" }
              }
            }
          }
        }
      },
      "ResourceNotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Not found" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": { "type": "integer", "example": 1 },
          "last_page": { "type": "integer", "example": 5 },
          "per_page": { "type": "integer", "example": 15 },
          "total": { "type": "integer", "example": 68 }
        }
      },
      "SettingsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            },
            "example": {
              "general": {
                "site_title": "KSP Mitra Sejati Persada",
                "tagline": "Tumbuh dan Sejahtera Bersama",
                "brand_color": "#1E3A8A"
              },
              "contact": {
                "phone": "+6281234567890",
                "email": "info@kspmitra.com",
                "address": "Jl. Raya Bisnis No. 10, Jakarta"
              }
            }
          }
        }
      },
      "PageSection": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "page_id": { "type": "integer", "example": 1 },
          "key": { "type": "string", "example": "hero" },
          "title": { "type": "string", "nullable": true, "example": "Solusi Keuangan Terpercaya" },
          "subtitle": { "type": "string", "nullable": true, "example": "Koperasi Simpan Pinjam Modern" },
          "body": { "type": "string", "nullable": true, "example": "Kami melayani simpanan dan pinjaman dengan bunga kompetitif." },
          "payload": { "type": "object", "nullable": true, "example": { "cta_text": "Daftar Anggota", "cta_url": "/inquiry" } },
          "image_path": { "type": "string", "nullable": true, "example": "sections/hero.jpg" },
          "image_url": { "type": "string", "nullable": true, "example": "http://localhost/storage/sections/hero.jpg" },
          "order": { "type": "integer", "example": 1 }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string", "example": "home" },
          "title": { "type": "string", "example": "Beranda" },
          "meta_title": { "type": "string", "nullable": true, "example": "Beranda - KSP Mitra Sejati Persada" },
          "meta_desc": { "type": "string", "nullable": true, "example": "Layanan simpan pinjam terpercaya dan profesional" },
          "is_published": { "type": "boolean", "example": true },
          "sections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PageSection" }
          }
        }
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/Page" }
        }
      },
      "ServiceType": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Simpanan Berjangka" },
          "slug": { "type": "string", "example": "simpanan-berjangka" },
          "description": { "type": "string", "nullable": true, "example": "Pilihan investasi simpanan dengan imbal hasil menarik" },
          "icon": { "type": "string", "nullable": true, "example": "piggy-bank" },
          "icon_url": { "type": "string", "nullable": true },
          "order": { "type": "integer", "example": 1 },
          "services_count": { "type": "integer", "example": 3 }
        }
      },
      "ServiceTypesResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ServiceType" }
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "service_type_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Simpanan Sejahtera Prima" },
          "slug": { "type": "string", "example": "simpanan-sejahtera-prima" },
          "short_desc": { "type": "string", "example": "Simpanan fleksibel dengan bagi hasil bulanan" },
          "body": { "type": "string", "example": "Penjelasan lengkap syarat dan ketentuan produk simpanan sejahtera prima..." },
          "icon_path": { "type": "string", "nullable": true },
          "thumbnail_path": { "type": "string", "nullable": true },
          "icon_url": { "type": "string", "nullable": true },
          "thumbnail_url": { "type": "string", "nullable": true },
          "features": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Bebas biaya admin bulanan", "Bagi hasil hingga 8% p.a.", "Dapat dicairkan kapan saja"]
          },
          "is_featured": { "type": "boolean", "example": true },
          "is_active": { "type": "boolean", "example": true },
          "order": { "type": "integer", "example": 1 },
          "service_type": { "$ref": "#/components/schemas/ServiceType" }
        }
      },
      "ServicesListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Service" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "ServiceDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/Service" }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "service_type_id": { "type": "integer", "nullable": true },
          "title": { "type": "string", "example": "Pembiayaan Modal Kerja Usaha Ritel" },
          "slug": { "type": "string", "example": "pembiayaan-modal-kerja-usaha-ritel" },
          "client_name": { "type": "string", "nullable": true, "example": "CV Berkah Abadi" },
          "completion_date": { "type": "string", "format": "date", "nullable": true, "example": "2025-10-15" },
          "description": { "type": "string", "nullable": true, "example": "Dukungan permodalan untuk ekspansi gerai baru" },
          "thumbnail_path": { "type": "string", "nullable": true },
          "thumbnail_url": { "type": "string", "nullable": true },
          "gallery_images": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "gallery_image_urls": { "type": "array", "items": { "type": "string" } },
          "order": { "type": "integer", "example": 1 },
          "is_featured": { "type": "boolean", "example": true },
          "service_type": { "$ref": "#/components/schemas/ServiceType" }
        }
      },
      "PortfoliosListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Portfolio" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "PortfolioDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/Portfolio" }
        }
      },
      "ArticleCategory": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Edukasi Finansial" },
          "slug": { "type": "string", "example": "edukasi-finansial" },
          "description": { "type": "string", "nullable": true, "example": "Tips dan wawasan pengelolaan keuangan usaha" },
          "order": { "type": "integer", "example": 1 },
          "articles_count": { "type": "integer", "example": 5 }
        }
      },
      "ArticleCategoriesResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArticleCategory" }
          }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "site_id": { "type": "string", "format": "uuid" },
          "article_category_id": { "type": "integer", "nullable": true, "example": 1 },
          "author_id": { "type": "integer", "nullable": true, "example": 1 },
          "title": { "type": "string", "example": "5 Cara Mengatur Arus Kas UMKM" },
          "slug": { "type": "string", "example": "5-cara-mengatur-arus-kas-umkm" },
          "excerpt": { "type": "string", "nullable": true, "example": "Panduan ringkas menjaga likuiditas usaha tetap sehat." },
          "body": { "type": "string", "example": "Arus kas adalah urat nadi bisnis..." },
          "thumbnail_path": { "type": "string", "nullable": true },
          "thumbnail_url": { "type": "string", "nullable": true },
          "status": { "type": "string", "example": "published" },
          "published_at": { "type": "string", "format": "date-time", "nullable": true },
          "category": { "$ref": "#/components/schemas/ArticleCategory" },
          "author": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1 },
              "name": { "type": "string", "example": "Super Admin" }
            }
          }
        }
      },
